{
  "name": "mini-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "seed": "node scripts/generate-seed.ts && prettier --write src/mocks/seed.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.18.1",
    "@mui/x-data-grid": "^9.18.0",
    "@tanstack/react-query": "^5.108.2",
    "msw": "^3.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "description": "Mini-CRM: sales dashboard with pipeline, contacts and metrics (React + TypeScript).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,html,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "oxlint --fix"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
